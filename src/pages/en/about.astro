---
import BaseLayout from '../../layouts/BaseLayout.astro'; import {copy} from '../../data'; const c=copy.en;
---
<BaseLayout title="About me" description={c.aboutText} lang="en" alternate="/about/">
<section class="container section prose"><p class="eyebrow">{c.role}</p><h1>{c.aboutTitle}</h1><p>{c.aboutText}</p><section class="experience" aria-labelledby="experience-title"><h2 id="experience-title">Professional Experience</h2><p class="experience-summary">Commercial development since 2015 across e-commerce, corporate systems, integrations, and backend services.</p><ol class="experience-list"><li class="experience-item"><p class="experience-period"><time datetime="2026-02">Feb 2026</time> — <time datetime="2026-10">Oct 2026</time></p><div><h3>Aromatny Mir</h3><p class="experience-role">PHP Backend Developer</p><p>Backend development for an e-commerce system on 1C-Bitrix D7. Marketplace integrations, monitoring, and backend security; Kafka, Logstash, and OpenSearch for logging and observability.</p></div></li><li class="experience-item"><p class="experience-period"><time datetime="2024-10">Oct 2024</time> — <time datetime="2025-09">Sep 2025</time></p><div><h3>RedLab</h3><p class="experience-role">PHP Backend Developer</p><p>Custom PHP projects using 1C-Bitrix, Symfony, or Laravel depending on the project. Contributed to an escrow module integrating with T-Bank and nominal accounts, and to a corporate Wiki portal built with Vue.js.</p></div></li><li class="experience-item"><p class="experience-period"><time datetime="2023-11">Nov 2023</time> — <time datetime="2024-06">Jun 2024</time></p><div><h3>Samokat.tech / ecom.tech</h3><p class="experience-role">PHP Backend Developer</p><p>Maintained microservices and refactored legacy code. Under a technical lead, contributed to migrating selected services from PHP 7.4 to PHP 8.x. Stack: Symfony, PostgreSQL, Kafka, Redis, and Docker.</p></div></li></ol><article class="experience-agency"><p class="experience-label">Own agency</p><div class="experience-agency-heading"><h3>artofall.agency</h3><p class="experience-period"><time datetime="2015">2015</time> — <time datetime="2024-10">Oct 2024</time></p></div><p class="experience-role">Fullstack Developer / Project Lead</p><p>Led custom web development and client projects, from solution design and client communication to integrations, planning, and ongoing support. One example is the KOLUNDROV online store on 1C-Bitrix, integrated with payment, delivery, CRM, and fulfillment services.</p></article></section><h2>{c.stackTitle}</h2><p>PHP · Symfony · Laravel · 1C-Bitrix D7/ORM · JavaScript · Vue 3 · PostgreSQL · MySQL · Redis · Docker · REST API · Kafka · Logstash · OpenSearch</p><p>Also: TypeScript, Inertia, testing, CI/CD, and AI-assisted development with Codex.</p><h2>Additional Education</h2><p><strong><a href="https://21-school.ru/" target="_blank" rel="noopener noreferrer">School 21 by Sber</a> — graduate</strong></p><p>School 21 is Sber’s education initiative in digital technology. Its practice-oriented format centers on project tasks and independent work. Through its peer-to-peer approach, participants exchange knowledge, review one another’s solutions, and give feedback; team projects complement individual problem-solving.</p><p>I see this education as a complement to my commercial experience and engineering projects.</p></section>
</BaseLayout>
<style>.section{padding-block:88px}.eyebrow{font-size:13px;color:var(--muted);letter-spacing:.08em}h1{font-size:clamp(2.25rem,5vw,4.25rem);line-height:1.12;letter-spacing:-.035em}h2{font-size:clamp(1.65rem,3vw,2.25rem);margin-top:56px}.prose p{color:var(--muted)}.prose a{color:var(--accent)} .experience{margin-top:56px}.experience h2{margin-top:0}.experience-summary{margin-bottom:20px}.experience-list{list-style:none;padding:0;margin:0}.experience-item{display:grid;grid-template-columns:minmax(150px,190px) minmax(0,1fr);gap:20px;padding:20px 0;border-top:1px solid var(--border)}.experience-item h3,.experience-agency h3{font-size:20px;line-height:1.3;margin:0}.experience-period{font-size:14px;color:var(--muted);margin:2px 0 8px}.experience-role{font-weight:600;color:var(--text)!important;margin:4px 0}.experience-item div>p:last-child,.experience-agency>p:last-child{margin-bottom:0}.experience-agency{margin-top:24px;padding:20px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.experience-label{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin:0 0 12px}.experience-agency-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px}.experience-agency-heading .experience-period{white-space:nowrap}.experience-agency-heading h3{overflow-wrap:anywhere}@media(max-width:700px){.experience-item{grid-template-columns:1fr;gap:4px}.experience-item .experience-period{margin:0}.experience-agency{padding:18px}.experience-agency-heading{display:block}.experience-agency-heading .experience-period{margin-top:4px}}@media(max-width:700px){.section{padding-block:60px}}</style>
