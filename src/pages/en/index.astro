---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { copy, projects } from '../../data'; const c=copy.en;
---
<BaseLayout title="Web services developer" description={c.intro} lang="en" alternate="/">
  <section class="container hero"><p class="eyebrow">{c.role}</p><h1>{c.homeTitle}</h1><p class="intro">{c.intro}</p><div class="actions"><a class="primary" href="https://t.me/meentrepreneur">{c.contact}</a><a href="mailto:hi@artofall.ru">{c.emailContact}</a><a class="projects-action" href="#projects">{c.explore} <span aria-hidden="true">→</span></a></div></section>
  <section class="container experience-teaser" aria-labelledby="experience-title"><div class="experience-heading"><h2 id="experience-title">{c.experienceTitle}</h2><p>{c.experienceIntro}</p></div><ul class="experience-teaser-list">{c.experienceItems.slice(0,3).map((item)=><li><strong>{item.company}</strong><span>{item.detail}</span></li>)}</ul></section><section class="container experience-teaser agency-teaser" aria-labelledby="agency-experience-title"><div class="experience-heading"><h2 id="agency-experience-title">{c.experienceAgencyLabel}</h2></div><div class="experience-agency"><div class="experience-agency-title"><strong>{c.experienceItems[3].company}</strong></div><span>{c.experienceItems[3].detail}</span></div></section><div class="container experience-more-wrap"><a class="experience-more" href="/en/about/">{c.experienceMore} <span aria-hidden="true">→</span></a></div>
  <section id="projects" class="container section"><h2>{c.featured}</h2><div class="grid">{projects.filter(p=>p.featured).map((p,i)=><article class="card"><div class="cardtop"><span class="muted">0{i+1}</span><span class="muted">{c.private}</span></div><h3>{p.title}</h3><p>{p.en}</p><p class="stack">{p.stack}</p><a class="more" href={`/en/projects/${p.slug}/`}>{c.more} <span aria-hidden="true">→</span></a></article>)}</div><h2 class="additional-title">{c.additional}</h2><div class="grid compact">{projects.filter(p=>!p.featured).map((p,i)=><article class="card"><div class="cardtop"><span class="muted">0{i+4}</span><span class="muted">{c.private}</span></div><h3>{p.title}</h3><p>{p.en}</p><p class="stack">{p.stack}</p><a class="more" href={`/en/projects/${p.slug}/`}>{c.more} <span aria-hidden="true">→</span></a></article>)}</div></section>
</BaseLayout>
<style>.hero{padding-block:104px 64px}.eyebrow{font-size:13px;letter-spacing:.08em;color:var(--muted)}h1{font-size:clamp(2.25rem,5vw,4.25rem);line-height:1.12;letter-spacing:-.035em;max-width:800px;margin:20px 0;font-weight:650}.intro{font-size:18px;max-width:720px;color:var(--muted)}.actions{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;margin-top:30px}.actions a{display:inline-flex;align-items:center;min-height:44px}.actions .primary{padding:8px 16px}.projects-action{gap:8px;margin-left:4px;padding:8px 12px;border:1px solid var(--border);border-radius:7px;background:var(--surface)}.projects-action:hover{background:var(--accent-soft);text-decoration:none}.actions a,.more{color:var(--accent);text-decoration:none}.primary{background:var(--accent-soft);padding:10px 16px;border-radius:7px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:28px}.card{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:26px;display:flex;flex-direction:column}.cardtop{display:flex;justify-content:space-between;font-size:13px}.card h3{font-size:25px;line-height:1.2;margin:24px 0 4px}.card p{color:var(--muted)}.stack{font-size:14px}.more{display:inline-flex;align-items:center;gap:8px;margin-top:auto;padding-top:12px}.additional-title{margin-top:76px}.compact .card{padding:22px}.compact .card h3{font-size:22px}.experience-teaser{margin-top:12px;padding:26px 30px 18px;border:1px solid var(--border);border-left:4px solid var(--accent);border-radius:12px;background:var(--surface)}.experience-heading{display:flex;align-items:end;justify-content:space-between;gap:24px}.experience-heading h2{font-size:clamp(1.55rem,2.8vw,2rem);line-height:1.2;margin:0}.experience-heading p{max-width:460px;color:var(--muted);margin:0;text-align:right}.experience-teaser-list{display:grid;grid-template-columns:minmax(0,1fr);list-style:none;padding:0;margin:18px 0 12px}.experience-teaser-list li{display:grid;grid-template-columns:minmax(190px,230px) minmax(0,1fr);gap:20px;padding:14px 0;border-top:1px solid var(--border);line-height:1.55}.experience-teaser-list strong{color:var(--text);overflow-wrap:anywhere}.experience-teaser-list span{color:var(--muted);overflow-wrap:anywhere}.experience-agency{display:grid;grid-template-columns:minmax(190px,230px) minmax(0,1fr);gap:20px;margin-top:4px;padding-top:18px;border-top:1px solid var(--border);line-height:1.55}.experience-agency-title p{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);margin:0 0 4px}.experience-agency-title strong{color:var(--text)}.experience-agency>span{color:var(--muted);overflow-wrap:anywhere}.experience-more-wrap{padding-top:24px}.experience-more{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 12px;border-radius:7px;background:var(--accent-soft);color:var(--accent);font-weight:600;text-decoration:none}.experience-more:hover{background:var(--border);text-decoration:none}@media(max-width:700px){.experience-teaser{padding:20px 18px 14px}.experience-more-wrap{padding-top:18px}.experience-heading{display:block}.experience-heading p{margin-top:8px;text-align:left}.experience-teaser-list{margin-top:14px}.experience-teaser-list li{grid-template-columns:minmax(0,1fr);gap:4px;padding-block:12px}.experience-agency{grid-template-columns:minmax(0,1fr);gap:4px}}
@media(max-width:700px){.hero{padding-block:72px 36px}.grid{grid-template-columns:1fr}.section{padding-block:56px}.additional-title{margin-top:56px}}</style>
