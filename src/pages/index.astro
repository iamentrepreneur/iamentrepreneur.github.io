---
import BaseLayout from '../layouts/BaseLayout.astro'; import { copy, projects } from '../data';
const c=copy.ru;
---
<BaseLayout title="Разработчик веб-сервисов" description={c.intro} lang="ru" alternate="/">
  <section class="container hero"><p class="eyebrow">{c.role}</p><h1>{c.homeTitle}</h1><p class="intro">{c.intro}</p><div class="actions"><a class="primary" href="https://t.me/meentrepreneur">{c.contact}</a><a href="mailto:hi@artofall.ru">{c.emailContact}</a><a class="projects-action" href="#projects">{c.explore} <span aria-hidden="true">→</span></a></div></section>
  <section id="projects" class="container section"><h2>{c.featured}</h2><div class="grid">{projects.filter(p=>p.featured).map((p,i)=><article class="card"><div class="cardtop"><span class="muted">0{i+1}</span><span class="muted">{c.private}</span></div><h3>{p.title}</h3><p>{p.ru}</p><p class="stack">{p.stack}</p><a class="more" href={`/projects/${p.slug}/`}>{c.more} <span aria-hidden="true">→</span></a></article>)}</div><h2 class="additional-title">{c.additional}</h2><div class="grid compact">{projects.filter(p=>!p.featured).map((p,i)=><article class="card"><div class="cardtop"><span class="muted">0{i+4}</span><span class="muted">{c.private}</span></div><h3>{p.title}</h3><p>{p.ru}</p><p class="stack">{p.stack}</p><a class="more" href={`/projects/${p.slug}/`}>{c.more} <span aria-hidden="true">→</span></a></article>)}</div></section>
</BaseLayout>
<style>.hero{padding-block:104px 64px}.eyebrow{font-size:13px;letter-spacing:.08em;color:var(--muted)}h1{font-size:clamp(2.25rem,5vw,4.25rem);line-height:1.12;letter-spacing:-.035em;max-width:800px;margin:20px 0;font-weight:650}.intro{font-size:18px;max-width:720px;color:var(--muted)}.actions{display:flex;flex-wrap:wrap;gap:12px 24px;align-items:center;margin-top:30px}.actions a{display:inline-flex;align-items:center;min-height:44px}.actions .primary{padding:8px 16px}.projects-action{margin-left:4px;padding:8px 12px;border:1px solid var(--border);border-radius:7px;background:var(--surface)}.projects-action:hover{background:var(--accent-soft);text-decoration:none}.actions a,.more{color:var(--accent);text-decoration:none}.primary{background:var(--accent-soft);padding:10px 16px;border-radius:7px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:28px}.card{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:26px;display:flex;flex-direction:column}.cardtop{display:flex;justify-content:space-between;font-size:13px}.card h3{font-size:25px;line-height:1.2;margin:24px 0 4px}.card p{color:var(--muted)}.stack{font-size:14px}.more{margin-top:auto;padding-top:12px}.additional-title{margin-top:76px}.compact .card{padding:22px}.compact .card h3{font-size:22px}@media(max-width:700px){.hero{padding-block:72px 36px}.grid{grid-template-columns:1fr}.section{padding-block:56px}.additional-title{margin-top:56px}}</style>
