---
import '../styles/global.css';
import { copy } from '../data';
const { lang='ru', title, description, alternate='/', canonical } = Astro.props;
const c = copy[lang];
const isEn = lang === 'en';
const author = isEn ? 'Ilya Volkov' : 'Илья Волков';
const ogImage = 'https://iamentrepreneur.github.io/og-image.png';
const current = canonical ?? (isEn ? `/en${Astro.url.pathname === '/en/' ? '/' : Astro.url.pathname.replace(/^\/en/, '')}` : Astro.url.pathname);
const alternateUrl = isEn ? alternate : `/en${alternate === '/' ? '/' : alternate}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {author}</title><meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={`https://iamentrepreneur.github.io${current}`} />
    <link rel="alternate" hreflang="ru" href={`https://iamentrepreneur.github.io${isEn ? alternate : current}`} />
    <link rel="alternate" hreflang="en" href={`https://iamentrepreneur.github.io${isEn ? current : alternateUrl}`} />
    <link rel="alternate" hreflang="x-default" href={`https://iamentrepreneur.github.io${isEn ? alternate : current}`} />
    <meta property="og:type" content="website" /><meta property="og:title" content={`${title} · ${author}`} /><meta property="og:description" content={description} /><meta property="og:url" content={`https://iamentrepreneur.github.io${current}`} /><meta property="og:site_name" content={isEn ? "Ilya Volkov — Portfolio" : "Илья Волков — Портфолио"} /><meta property="og:locale" content={isEn ? "en_US" : "ru_RU"} /><meta property="og:locale:alternate" content={isEn ? "ru_RU" : "en_US"} /><meta property="og:image" content={ogImage} /><meta property="og:image:type" content="image/png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={isEn ? "Ilya Volkov — Senior PHP / Backend Developer portfolio" : "Портфолио Ильи Волкова — Senior PHP / Backend Developer"} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={`${title} · ${author}`} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} /><meta name="twitter:image:alt" content={isEn ? "Ilya Volkov — Senior PHP / Backend Developer portfolio" : "Портфолио Ильи Волкова — Senior PHP / Backend Developer"} />
    <script is:inline>try{const t=localStorage.getItem('theme');document.documentElement.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}catch(e){document.documentElement.dataset.theme=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}</script>
  </head>
  <body>
    <a class="skip" href="#main">{isEn ? "Skip to content" : "Перейти к содержимому"}</a>
    <header class="container header">
      <a class="brand" href={isEn?'/en/':'/'}>{author}</a>
      <nav aria-label={isEn?'Main navigation':'Основная навигация'}><a href={isEn?'/en/#projects':'/#projects'}>{c.projects}</a><a href={isEn?'/en/about/':'/about/'}>{c.about}</a></nav>
      <div class="controls"><a href={isEn?alternate:`/en${alternate==='/'?'/':alternate}`} lang={isEn?'ru':'en'} aria-label={isEn?'Switch to Russian':'Switch to English'}>{isEn?'RU':'EN'}</a><button id="theme-toggle" type="button" data-dark-label={isEn?'Switch to light theme':'Включить светлую тему'} data-light-label={isEn?'Switch to dark theme':'Включить тёмную тему'} aria-label={isEn?'Switch to dark theme':'Включить тёмную тему'} aria-pressed="false"><span aria-hidden="true">◐</span> <span>{isEn?'Theme':'Тема'}</span></button></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="container footer"><span>© {new Date().getFullYear()} {author}</span><nav class="footer-links" aria-label={c.contactLinks}><a href="https://t.me/meentrepreneur" target="_blank" rel="noopener noreferrer">{c.telegram}</a><a href="mailto:hi@artofall.ru">{c.email}</a><a href="https://github.com/iamentrepreneur" target="_blank" rel="noopener noreferrer">{c.github}</a></nav></footer>
    <script is:inline>
      const b=document.getElementById('theme-toggle');
      const sync=()=>{const d=document.documentElement.dataset.theme==='dark';b.setAttribute('aria-pressed',String(d));b.setAttribute('aria-label',d?b.dataset.darkLabel:b.dataset.lightLabel)};sync();
      const systemTheme=matchMedia('(prefers-color-scheme: dark)');
      systemTheme.addEventListener('change',e=>{let saved;try{saved=localStorage.getItem('theme')}catch(_){}if(saved!=='dark'&&saved!=='light'){document.documentElement.dataset.theme=e.matches?'dark':'light';sync()}});
      b.addEventListener('click',()=>{const d=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=d?'dark':'light';try{localStorage.setItem('theme',d?'dark':'light')}catch(e){}sync()});
    </script>
  </body>
</html>
<style>
 .header{min-height:76px;display:flex;align-items:center;gap:32px;border-bottom:1px solid var(--border)}.brand{text-decoration:none;font-weight:650}.header a:hover:not(.brand),.footer a:hover,.header nav a:hover,.controls a:hover{text-decoration:underline;text-underline-offset:.18em;color:var(--text)}.controls button:hover{color:var(--accent)}.header nav{display:flex;gap:24px;margin-left:auto}.header nav a,.controls a{color:var(--muted);text-decoration:none;display:inline-flex;align-items:center;min-height:44px}.controls{display:flex;align-items:center;gap:18px}.controls button{font:inherit;color:var(--text);background:none;border:0;cursor:pointer;min-height:44px;padding:0 4px}.footer{border-top:1px solid var(--border);padding-block:24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 20px;color:var(--muted);font-size:14px}.footer-links{display:flex;flex-wrap:wrap;align-items:center;gap:4px 18px}.footer a{color:var(--muted)}.footer-links a{display:inline-flex;align-items:center;min-height:44px}.skip{position:absolute;left:-999px;top:8px;background:var(--surface);padding:8px;z-index:5}.skip:focus-visible{left:8px}@media(max-width:620px){.header{gap:8px 12px;flex-wrap:wrap;padding-block:12px}.header nav{margin-left:auto;gap:14px}.controls{margin-left:auto}.controls button span{display:none}}
</style>
